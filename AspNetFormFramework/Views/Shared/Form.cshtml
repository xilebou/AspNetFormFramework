@using Microsoft.AspNetCore.Mvc.ModelBinding
@model AspNetFormFramework.FormGeneration.FormViewModel;

<!DOCTYPE html>

<html lang="en">
<head>
    <title>@Model.Name</title>
    <link rel="stylesheet" href="~/form.css">
</head>
<body>
<div class="row">
    <div></div>
    <div class="main">
        <h1>@Model.Title</h1>

        <form action="@Model.PostRoute" method="POST">
            @{
                int i = 0;
                foreach (var input in Model.Inputs ?? new())
                {
                    <label for="@i">@input.label</label>
                    <input id="@i" type="@input.inputType" name="@input.name" value="@input.value"/>
                    @if (ViewData.ModelState[input.name]?.Errors.Count > 0)
                    {
                        <span>@ViewData.ModelState[input.name]?.Errors[0].ErrorMessage</span>
                    }
                    <br/>
                    i++;
                }
            }
            <button type="submit">submit</button>
        </form>
    </div>
    <div></div>
</div>
</body>
</html>