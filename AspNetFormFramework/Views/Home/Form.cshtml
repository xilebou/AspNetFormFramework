@model AspNetFormFramework.ViewModels.FormInfo;

<!DOCTYPE html>

<html lang="en">
<head>
    <title>@Model.Name</title>
</head>
<body>
<div>
    <h1>Voici le formulaire de @Model.Name</h1>
    <div>
        <form action="http://localhost:5013/send" method="post">
            @{
                int i = 0;

                foreach (var input in Model.Inputs ?? new List<(string, string)>())
                {
                    <label for="@i">@input.label</label>
                    <input id="@i" type="@input.inputType"/>
                    <br/>
                    i++;
                }
            }

        </form>
    </div>
</div>
</body>
</html>